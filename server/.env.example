# === Database (Hostinger hPanel → 数据库 → MySQL) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME

# === API Key (必须与 ESP32 main/remote.c 中 DEVICE_API_KEY 一致) ===
API_KEY=YOUR_LONG_RANDOM_API_KEY_AT_LEAST_32_CHARS

# === Express 监听端口 ===
# Hostinger Cloud Web Apps 自动分配, 通常是 3000
PORT=3000