# === Database (Supabase Postgres 完整连接串) ===
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# === API Key (必须与 ESP32 main/remote.c 中 DEVICE_API_KEY 一致) ===
API_KEY=YOUR_LONG_RANDOM_API_KEY_AT_LEAST_32_CHARS

# === Express 监听端口 ===
# Hostinger Cloud Web Apps 自动分配, 通常是 3000
PORT=3000